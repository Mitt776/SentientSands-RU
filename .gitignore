# ─── СЕКРЕТЫ ────────────────────────────────────────────────────────────────
# Живые ключи LLM-провайдеров. Шаблон лежит рядом: providers.json.example —
# скопируй его в providers.json и впиши свои ключи.
server/config/providers.json


# ─── БИНАРНИКИ БЕЗ ИСХОДНИКОВ ───────────────────────────────────────────────
# GPL-3.0 требует предоставить исходный код к распространяемому бинарю.
# Исходников SentientSands.dll v0.5.0 публично не существует (проверено:
# заявленный репозиторий содержит только LICENSE и README), поэтому сам
# бинарник в публичный репозиторий не выкладывается.
# Бери DLL из оригинальной поставки мода в мастерской Steam.
SentientSands.dll


# ─── ВСТРОЕННЫЙ PYTHON (~68 МБ) ─────────────────────────────────────────────
# Восстанавливается командой:
#   server/python/python.exe server/setup_embedded_python.py
# либо любым системным python 3.13.
server/python/


# ─── ЛОГИ ───────────────────────────────────────────────────────────────────
*.log
server/logs/
Kayak/KayakDB/Campaigns/*/logs/
Kayak/KayakDB/Template/logs/


# ─── ЛИЧНЫЕ ИГРОВЫЕ ДАННЫЕ ──────────────────────────────────────────────────
# Кампании создаются копированием KayakDB/Template при старте новой игры
# и содержат диалоги, профили NPC и историю событий конкретного сейва.
server/campaigns/
Kayak/KayakDB/Campaigns/
sentient_sands_registry/


# ─── БЭКАПЫ И ВРЕМЕННОЕ ─────────────────────────────────────────────────────
*.bak
*.bak2
*.bak_lore
*.orig
*.tmp


# ─── PYTHON ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/


# ─── РЕДАКТОРЫ И ОС ─────────────────────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
